# Build-stamped pipeline cache (DB2 CSVs, WDTs, minimap BLPs)
.cache-*/

# Auto-generated project README; rebuilt from docs/ and intentionally not kept in
# local git state so branch updates do not cause divergence for contributors.
README.md

# CI's one-zone smoke builds
smoke/
smoke-ocean/

# Python
__pycache__/
*.py[cod]

# BigWigs packager staging dir (and a local copy of release.sh, if you keep one)
.release/
.env

# Ace3 libraries are fetched at build/dev time (see .pkgmeta's externals and
# src/addon/client/dev/fetch-libs.sh) and are not committed.
src/addon/client/Libs/
.act.hfwm-app-private-key.pem
.act.secrets

# Local Kdenlive trailer project (video/audio assets, thumbnails)
assets/projects/trailer/
assets/images/sidepanel_toggle/
# Local omp agent/command config
.omp/
