# BigWigs packager config: https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File
#
# Repository layout: the addon lives in src/addon/client/, everything else
# (src/generator/, docs/, dev/, assets/, CI) is repo machinery that must not
# ship. The packager wants the TOC at the top of the checkout, so it copies the
# whole checkout into the package folder and `move-folders` below hoists
# src/addon/client/ to the top.
#
# src/addon/art/ (the high-resolution map art) is its own addon, built from
# .pkgmeta-art; it is not part of this package. The low-resolution art
# (src/addon/client/WorldMap/) is gitignored, built by CI's generate-world-map-assets
# action and shipped here as built. The Fog of War zone masks (src/addon/client/ZoneMasks/)
# are built from the hand traces in continent-fog-masks/, which is not shipped.

package-as: HighFidelityWorldMap

# The packager would write a CHANGELOG.md into the package. A manual changelog
# is read from the checkout instead and only used for the upload, so none ships.
# The workflows write it with .github/scripts/release-notes.sh; without that
# file the packager falls back to generating CHANGELOG.md.
manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

# Hoist the addon out of src/addon/client/ so the TOC ends up at the package root.
move-folders:
  HighFidelityWorldMap/src/addon/client: HighFidelityWorldMap

# Everything outside src/addon/client/ is build machinery or a repo-level
# document, none of it belongs in the package users download. Dotfiles (.github,
# .git, .gitignore, .pkgmeta, .release, src/generator/.cache-*) are skipped by
# the packager on its own. A new top-level file or folder that is not part of
# the addon needs an entry here.
ignore:
  - AI-DISCLOSURE.md
  - CONTRIBUTING.md
  - CurseForgeDescription.md
  - README.md
  - SECURITY.md
  - HighFidelityWorldMap.code-workspace
  - assets
  - continent-fog-masks
  - docs
  - src/addon/client/dev
  - src/addon/art
  - src/generator

# Ace3: fetched here rather than committed, from the canonical WowAce svn
# trunk, per Ace3's own packaging guidance. Paths are inside the package
# before move-folders runs, hence the src/addon/client/ prefix. src/addon/client/dev/fetch-libs.sh gets
# the same libraries locally from a GitHub mirror instead, so a checkout only needs
# git, not svn, to test with; see that script's own comment for why.
externals:
  src/addon/client/Libs/LibStub: https://repos.wowace.com/wow/ace3/trunk/LibStub
  src/addon/client/Libs/CallbackHandler-1.0: https://repos.wowace.com/wow/ace3/trunk/CallbackHandler-1.0
  src/addon/client/Libs/AceAddon-3.0: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  src/addon/client/Libs/AceEvent-3.0: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
  src/addon/client/Libs/AceConsole-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0
  src/addon/client/Libs/AceDB-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
  src/addon/client/Libs/AceDBOptions-3.0: https://repos.wowace.com/wow/ace3/trunk/AceDBOptions-3.0
  src/addon/client/Libs/AceGUI-3.0: https://repos.wowace.com/wow/ace3/trunk/AceGUI-3.0
  src/addon/client/Libs/AceConfigRegistry-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0/AceConfigRegistry-3.0
  src/addon/client/Libs/AceConfigDialog-3.0: https://repos.wowace.com/wow/ace3/trunk/AceConfig-3.0/AceConfigDialog-3.0

# A nolib build would be missing Ace3 entirely and not load, so don't offer one.
enable-nolib-creation: no

# Single `## Interface:` line, single game flavour (Forever, 16xxx), nothing to
# split.
enable-toc-creation: no

# The high-resolution map art is its own, optional CurseForge project (built from
# .pkgmeta-art, https://www.curseforge.com/wow/addons/hfwm-art), so a client
# update is not a 1 GB download. Without it the client still works; the World
# and continent maps just stay at low resolution. The packager declares it as an
# optional relation on every CurseForge upload. CurseForge rejects relations
# to projects that are not approved
# and public, so the upload fails if that project ever stops being so.
optional-dependencies:
  - hfwm-art
